# Enable only on the approved document root once .org hosting and TLS work.
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?sorp2026\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.sorp2026\.org$ [NC]
RewriteRule ^ https://sorp2026.org%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://sorp2026.org%{REQUEST_URI} [R=301,L,NE]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>
