# Optional overrides. Verified defaults are in src/lib/site.ts.
READINESS_ASSESSMENT_URL=
MSI_PLATFORM_URL=
IDEAS_SHED_URL=
# Enable only after editorial review, .org TLS/hosting and deployment approval.
SITE_LIVE=false
# Set true for IONOS shared hosting (static files in out/).
STATIC_EXPORT=false

# Are You SORP Ready service connections. Configure destination-specific
# credentials in the deployment platform; never commit values here.
SORP_READINESS_API_URL=https://sorp2026.mysocialimpact.org/api/readiness
SORP_REPORT_EMAIL_API_URL=https://sorp2026.mysocialimpact.org/api/report-email
COW_GROWTH_EVENT_URL=
COW_GROWTH_EVENT_KEY=
SORP_BACKEND_ORIGIN=https://mysocialimpact.org
SORP_PAYMENT_SERVICE_URL=https://milkmaid.theideasshed.com
SORP_PAYMENT_SERVICE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=https://sorp2026.org/api/booking/google/callback

# Private accountant research console. Server-only; never use NEXT_PUBLIC_.
ADMIN_EMAIL=
# Explicit founder identity; the live SORP session is still verified server-side.
FOUNDER_EMAIL=marcus@mysocialimpact.org
# Scoped Postgres role with access only to research_console schema.
CONSOLE_DATABASE_URL=

# Independent SORP authentication. Keep staging disabled until the complete
# account migration, permissions, mail delivery and cutover gates pass.
# Use a separate pooled Neon role scoped to sorp_auth; never reuse the console role.
SORP_AUTH_STAGING_ENABLED=false
# Switches the existing account and server permission paths. Keep false until all release gates pass.
SORP_AUTH_CUTOVER_ENABLED=false
SORP_AUTH_DATABASE_URL=
SORP_AUTH_SECRET=
SORP_AUTH_BASE_URL=
# Only set after sorp2026.org is verified for sending in Resend.
# Sender: SORP 2026 <accounts@sorp2026.org>; Reply-To: marcus@mysocialimpact.org.
RESEND_API_KEY=
# Keep delivery off until the founder approves exact synthetic test recipients.
SORP_AUTH_EMAIL_DELIVERY_ENABLED=false
# allowlist for synthetic testing; public only with the live cutover enabled at https://sorp2026.org.
SORP_AUTH_EMAIL_RECIPIENT_POLICY=allowlist
SORP_AUTH_EMAIL_ALLOWED_RECIPIENTS=
# Add any verified Brainstrust contact address outside its domain here before public delivery.
SORP_AUTH_EMAIL_BLOCKED_RECIPIENTS=
# Brainstrust transactional email remains blocked even if its domain is listed above.
# Temporary owner-initiated download from the existing session; leave off until scheduled.
SORP_AUTH_LEGACY_EXPORT_ENABLED=false

# OpenAI Responses API + built-in web search (server-only).
OPENAI_API_KEY=
# Existing Vercel installations may also use OPEN_API_KEY as a server-only alias.
# Estimated USD admission limits; zero pauses new API requests.
CONSOLE_AI_DAILY_USD=5
CONSOLE_AI_MONTHLY_USD=25

# Conversational onboarding: additive preview only. Apply migration 012 in staging.
# Uses the existing console Postgres connection and existing OpenAI key alias.
SORP_ONBOARDING_ENABLED=false
SORP_ONBOARDING_DAILY_USD=1
SORP_ONBOARDING_MONTHLY_USD=10
# Existing S3-compatible object service, scoped to a separate prefix/bucket.
# Do not copy backup credentials or provision a paid service automatically.
CHARITY_DOCUMENT_ENDPOINT=
CHARITY_DOCUMENT_BUCKET=
CHARITY_DOCUMENT_REGION=us-east-1
CHARITY_DOCUMENT_ACCESS_KEY_ID=
CHARITY_DOCUMENT_SECRET_ACCESS_KEY=
# Enable only after publisher access/licensing and storage configuration are reviewed.
CHARITY_DOCUMENT_DOWNLOAD_ENABLED=false
# Existing transcription service; raw audio is not stored by the onboarding app.
SORP_TRANSCRIBE_API_URL=https://sorp2026.mysocialimpact.org/api/transcribe
